# --- XDG Base Directory 設定 ---
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"

# --- Mise や自作ツールのパス設定 ---
case ":${PATH}:" in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# --- WSL2 でのブラウザ設定 ---
# xdg-open を呼ばず $BROWSER を直接参照する CLI 向け
if [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qi microsoft /proc/version 2>/dev/null; then
    export BROWSER='/mnt/c/Windows/System32/rundll32.exe url.dll,FileProtocolHandler'
fi

# alias や関数などインタラクティブシェル専用の設定は .zshrc に置く。
# .zshenv は scp / cron / 非対話 zsh からも評価されるため、
# 対話前提の設定を入れると副作用 (stderr 漏れなど) の温床になる。