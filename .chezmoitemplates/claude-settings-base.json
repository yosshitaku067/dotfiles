{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/status-line.js"
  },
  "enabledPlugins": {
    "tsumiki@tsumiki": true
  },
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "Generated with Claude Code\nCo-authored-by: Claude <claude-code@anthropic.com>",
    "pr": "Generated with Claude Code\nCo-authored-by: Claude <claude-code@anthropic.com>"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(dust:*)",
      "Bash(jq:*)",
      "Bash(eza:*)",
      "Bash(wc:*)",
      "Bash(lcurl:*)",
      "Bash(dcurl:*)",
      "Bash(lsof:*)",
      "Bash(bat:*)",
      "Bash(which:*)",
      "Bash(ps:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(realpath:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(nslookup:*)",
      "Bash(dig:*)",
      "Bash(host:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git pull:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(git remote:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree prune:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api repos/*/pulls/*/comments:*)",
      "Bash(gh api repos/*/pulls/*/reviews:*)",
      "Bash(gh api repos/*/issues/*/comments:*)",
      "Bash(gh api user:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh label create:*)",
      "Bash(gh milestone:*)",
      "Bash(pnpm ls:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm info:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm dev:local:*)",
      "Bash(pnpm dev:local:all:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm check:write:*)",
      "Bash(pnpm check:all:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm typecheck:packages:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test:unit:local:*)",
      "Bash(pnpm ls:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:npmjs.org)",
      "Bash(curl *localhost*)",
      "Bash(curl *127.0.0.1*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*token*)",
      "Read(**/*secret*)",
      "Read(.env)",
      "Read(.env.dev)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(**/.env)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/*secret*)",
      "Read(**/*_key*)",
      "Read(**/*.key*)",
      "Read(**/*apiKey*)",
      "Edit(**/*secret*)",
      "Edit(.env)",
      "Edit(.env.dev)",
      "Edit(.env.staging)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)"
    ],
    "ask": [
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(wget:*)",
      "Bash(curl:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "Bash(git apply:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm i:*)",
      "Bash(pnpm add:*)"
    ]
  }
}
